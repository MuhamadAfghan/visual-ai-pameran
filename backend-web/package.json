{
  "name": "backend-web",
  "version": "0.1.0",
  "private": true,
  "description": "Backend web service for CCTV detector orchestration",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run free:port && tsx watch src/server.ts",
    "dev:full": "concurrently -n rtsp,backend -c blue,green \"npm run rtsp:start\" \"npm run dev\"",
    "free:port": "powershell -ExecutionPolicy Bypass -File scripts/dev/free-port.ps1 8080",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "migrate:fresh": "tsx src/scripts/migrateFresh.ts --fresh",
    "migrate": "tsx src/scripts/migrateFresh.ts --migrate",
    "migrate:drop-locations": "tsx src/scripts/mergeLocationsIntoAreas.ts",
    "seed:roles": "tsx src/scripts/seedSystemRoles.ts",
    "seed:dummy-users": "tsx src/scripts/seedDummyUsers.ts",
    "seed:dev-cameras": "tsx src/scripts/seedDevCameras.ts",
    "backfill:user-roles": "tsx src/scripts/backfillUserRoleIds.ts",
    "rtsp:start": "powershell -ExecutionPolicy Bypass -File scripts/dev/start-fake-rtsp.ps1",
    "rtsp:stop": "powershell -ExecutionPolicy Bypass -File scripts/dev/stop-fake-rtsp.ps1",
    "smoke:grpc": "tsx src/scripts/smokeGrpcViolation.ts --crowd-threshold 0",
    "smoke:integration": "tsx src/scripts/smokeIntegrationViolation.ts --crowd-threshold 0",
    "smoke:rtsp": "tsx src/scripts/smokeRtspIntegration.ts --crowd-threshold 0",
    "smoke:redis": "tsx src/scripts/smokeRedis.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.2",
    "nodemailer": "^8.0.7",
    "opentype.js": "^2.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/opentype.js": "^1.3.10",
    "@types/sharp": "^0.31.1",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.0.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.10.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.1"
  }
}
