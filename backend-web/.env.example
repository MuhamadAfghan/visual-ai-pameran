NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017/cctv_detector
REDIS_URL=redis://localhost:6379
AI_GRPC_TARGET=localhost:50051
INFER_QUEUE_NAME=infer-jobs
SNAPSHOT_QUEUE_NAME=snapshot-jobs
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
JWT_REMEMBER_ME_EXPIRES_IN=7d
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
RESET_PASSWORD_TOKEN_TTL_MINUTES=30
APP_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Local snapshot storage
STORAGE_BASE_PATH=./storage
STORAGE_BASE_URL=http://localhost:8080/storage

# Notification cooldown: seconds before re-alerting the same PIC for the same violation type
NOTIFICATION_COOLDOWN_SECONDS=300

# AES-256-GCM key for encrypting SMTP credentials in DB (64-char hex = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=

# Allowed CORS origins — comma-separated for production, * for development
# Example: http://localhost:5173,https://cctv.yourcompany.com
CORS_ORIGIN=*
